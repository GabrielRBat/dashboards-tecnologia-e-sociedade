# Porta do PostgreSQL na sua máquina.
# Use outro valor (ex.: 5433) se a 5432 já estiver ocupada por outro PostgreSQL —
# lembre de refletir a mesma porta na DATABASE_URL abaixo.
DB_PORT=5432

# Banco de dados (usado pela API / Drizzle)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/argamassas"

# API
API_PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Frontend (Next.js) — URL pública da API
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------

# Chave que assina os tokens de sessão. A API NÃO SOBE sem ela, e não existe
# valor padrão de propósito: um padrão viveria no repositório, e quem o lesse
# poderia forjar um token de administrador.
#
# Gere a sua (cada instalação tem a dela) e cole abaixo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SEGREDO=""

# Usado por `npm run criar-admin` e `npm run redefinir-senha`.
#
# ADMIN_EMAIL aceita um e-mail ou um nome de usuário simples ("admin").
# Deixe ADMIN_SENHA em branco para o script sortear uma senha forte e mostrá-la
# no terminal uma única vez — é o caminho recomendado.
#
# Uma senha curta digitada aqui é aceita pelos comandos de terminal, com aviso.
# Serve para desenvolvimento local; num sistema exposto na internet, não use.
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin"
ADMIN_SENHA=""
