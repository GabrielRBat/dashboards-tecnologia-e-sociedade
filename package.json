{
  "name": "dashboard-argamassas",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard de dados de ensaios e formulações de argamassa",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@argamassas/api",
    "dev:web": "npm run dev --workspace=@argamassas/web",
    "build": "npm run build --workspace=@argamassas/shared && npm run build --workspace=@argamassas/api && npm run build --workspace=@argamassas/web",
    "test": "npm run test --workspace=@argamassas/api",
    "db:generate": "npm run db:generate --workspace=@argamassas/api",
    "db:migrate": "npm run db:migrate --workspace=@argamassas/api",
    "db:seed": "npm run db:seed --workspace=@argamassas/api",
    "criar-admin": "npm run criar-admin --workspace=@argamassas/api",
    "db:studio": "npm run db:studio --workspace=@argamassas/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
